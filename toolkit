#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SAT_HOME="${SAT_HOME:-$HOME/.local/share/security-agent-toolkit}"
export ROOT SAT_HOME PATH="$SAT_HOME/bin:$PATH"

source "$ROOT/lib/platform.sh"
source "$ROOT/lib/project.sh"
source "$ROOT/lib/dependencies.sh"

usage() {
  cat <<'EOF'
Security Agent Toolkit

Usage:
  ./toolkit <command> [arguments]

Commands:
  list
      List all available security-analysis modules.

  platform
      Detect the current operating system/platform and verify support.

  doctor <module>
      Check core, required and optional module dependencies separately.

  install <module> [--with-optional]
      Install OpenCode, shared runtime and required module dependencies.
      --with-optional installs extras such as the managed Android Emulator used
      by APK dynamic analysis.

  init <module> <destination>
      Create a local analysis workspace outside this Git repository.

  validate-module <module>
      Validate one module against the toolkit module contract.

  validate
      Validate all modules.

  repo-guard
      Check that the toolkit repository contains no assessment/project data.

Examples:
  ./toolkit install apk
  ./toolkit install apk --with-optional
  ./toolkit init apk ~/security-work/customer-app

Runtime location:
  ~/.local/share/security-agent-toolkit

Supported platforms for static modules:
  Ubuntu 24.04 / 26.04
  Debian 12 / 13
  Kali Rolling
  Parrot OS 7.x

APK dynamic analysis optionally uses a toolkit-managed Android Emulator. Dynamic
setup probes bare metal/VM/container, /dev/kvm, emulator acceleration and package
ABI compatibility, then selects accelerated, software or unavailable mode. The
toolkit never reconfigures the host hypervisor or container device passthrough.
EOF
}

need() {
  [[ $# -ge $1 ]] || {
    echo "Missing required argument(s)." >&2
    echo >&2
    usage >&2
    exit 2
  }
}

modok() {
  [[ -f "$ROOT/modules/$1/module.toml" ]] || {
    echo "Unknown module: $1" >&2
    echo "Available modules:" >&2
    python3 "$ROOT/lib/manifest.py" list "$ROOT/modules" >&2 || true
    exit 2
  }
}

cmd="${1:-}"
case "$cmd" in
  list)
    python3 "$ROOT/lib/manifest.py" list "$ROOT/modules"
    ;;

  platform)
    sat_require_supported_platform
    sat_print_platform
    ;;

  doctor)
    need 2 "$@"
    modok "$2"
    sat_require_supported_platform
    echo "Core dependencies"
    sat_doctor_dependency opencode
    sat_doctor_dependency uv
    echo
    echo "Required module dependencies: $2"
    while read -r dependency; do
      [[ -n "$dependency" ]] && sat_doctor_dependency "$dependency"
    done < <(python3 "$ROOT/lib/manifest.py" deps "$ROOT/modules/$2/module.toml" required)
    echo
    echo "Optional module dependencies: $2"
    optional_found=false
    while read -r dependency; do
      [[ -z "$dependency" ]] && continue
      optional_found=true
      sat_doctor_dependency "$dependency"
    done < <(python3 "$ROOT/lib/manifest.py" deps "$ROOT/modules/$2/module.toml" optional)
    $optional_found || echo "  (none)"
    ;;

  install)
    need 2 "$@"
    modok "$2"
    sat_require_supported_platform
    dep_mode="required"
    if [[ "${3:-}" == "--with-optional" ]]; then
      dep_mode="all"
    elif [[ -n "${3:-}" ]]; then
      echo "Unknown install option: ${3}" >&2
      exit 2
    fi
    echo "Installing core runtime and $dep_mode dependencies for module: $2"
    echo "Toolkit runtime: $SAT_HOME"
    echo
    sat_install_core
    while read -r dependency; do
      [[ -n "$dependency" ]] && sat_install_dependency "$dependency"
    done < <(python3 "$ROOT/lib/manifest.py" deps "$ROOT/modules/$2/module.toml" "$dep_mode")
    echo
    echo "Installation completed for module: $2"
    echo "Run './toolkit doctor $2' to verify the installation."
    ;;

  init)
    need 3 "$@"
    modok "$2"
    sat_init_project "$ROOT" "$2" "$3"
    ;;

  validate-module)
    need 2 "$@"
    modok "$2"
    python3 "$ROOT/lib/validate.py" module "$ROOT" "$2"
    ;;

  validate)
    python3 "$ROOT/lib/validate.py" all "$ROOT"
    ;;

  repo-guard)
    python3 "$ROOT/tests/repo_guard.py" "$ROOT"
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "Unknown command: $cmd" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
